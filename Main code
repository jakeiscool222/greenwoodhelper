<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
  <title>Omni droid V8 Mobile Simulator</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      color-scheme: dark;
      --panel-bg: rgba(6, 12, 24, 0.72);
      --panel-border: rgba(96, 140, 255, 0.4);
      --text: #e9f1ff;
      --accent: #ff5f2e;
      --accent-soft: rgba(255, 95, 46, 0.45);
      --blue: rgba(82, 138, 255, 0.9);
      font-family: "Poppins", "Segoe UI", system-ui, sans-serif;
    }

    * {
      box-sizing: border-box;
      -webkit-user-select: none;
      user-select: none;
    }

    html, body {
      margin: 0;
      height: 100%;
      overflow: hidden;
      background: radial-gradient(circle at 50% -10%, #15203b 0%, #04070f 55%, #010208 100%);
      color: var(--text);
    }

    body {
      position: relative;
    }

    #canvas-container {
      position: fixed;
      inset: 0;
      overflow: hidden;
    }

    canvas {
      display: block;
      width: 100%;
      height: 100%;
      touch-action: none;
      cursor: grab;
    }

    canvas:active {
      cursor: grabbing;
    }

    .panel {
      position: fixed;
      background: var(--panel-bg);
      border: 1px solid var(--panel-border);
      border-radius: 20px;
      padding: 0.85rem 1.2rem;
      backdrop-filter: blur(16px);
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
      z-index: 6;
      color: var(--text);
    }

    #hud {
      top: 1.25rem;
      left: 50%;
      transform: translateX(-50%);
      width: min(92vw, 420px);
      text-align: center;
      pointer-events: none;
    }

    #hud h1 {
      font-size: clamp(1.35rem, 4vw, 2rem);
      margin: 0 0 0.35rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #hud p {
      margin: 0;
      font-size: clamp(0.82rem, 2.3vw, 0.98rem);
      opacity: 0.8;
      line-height: 1.4;
    }

    #recenter {
      bottom: clamp(9.5rem, 12vh, 12rem);
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.96rem;
      font-weight: 600;
      border: none;
      outline: none;
      background: linear-gradient(135deg, rgba(90, 144, 255, 0.95), rgba(48, 94, 220, 0.95));
      color: #fff;
      padding: 0.75rem 1.8rem;
      border-radius: 999px;
      cursor: pointer;
      transition: transform 0.18s ease, box-shadow 0.18s ease;
      pointer-events: auto;
    }

    #recenter:active {
      transform: translateX(-50%) scale(0.97);
      box-shadow: 0 10px 26px rgba(48, 94, 220, 0.4);
    }

    .joystick {
      position: fixed;
      width: clamp(112px, 28vw, 160px);
      height: clamp(112px, 28vw, 160px);
      border-radius: 50%;
      background: rgba(8, 16, 32, 0.6);
      border: 1px solid rgba(120, 160, 255, 0.38);
      backdrop-filter: blur(14px);
      box-shadow: 0 18px 32px rgba(0, 0, 0, 0.45);
      bottom: 1.6rem;
      z-index: 7;
      touch-action: none;
    }

    .joystick::after {
      content: "";
      position: absolute;
      inset: 14%;
      border-radius: 50%;
      border: 1px dashed rgba(146, 180, 255, 0.28);
    }

    .joystick .stick {
      --x: 0px;
      --y: 0px;
      position: absolute;
      width: clamp(60px, 16vw, 84px);
      height: clamp(60px, 16vw, 84px);
      top: 50%;
      left: 50%;
      transform: translate3d(calc(-50% + var(--x)), calc(-50% + var(--y)), 0);
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, rgba(150, 196, 255, 0.95), rgba(70, 118, 220, 0.88));
      box-shadow: 0 14px 28px rgba(30, 52, 120, 0.55);
      transition: transform 0.16s ease-out;
    }

    .joystick.active .stick {
      transition: none;
    }

    #leftJoystick {
      left: 1.5rem;
    }

    #rightJoystick {
      right: 1.5rem;
    }

    @media (hover: hover) and (pointer: fine) {
      .joystick {
        opacity: 0.55;
      }
    }

    @media (max-width: 540px) {
      #hud {
        top: 0.85rem;
        padding: 0.7rem 1.1rem;
      }

      #recenter {
        bottom: 8.8rem;
        padding: 0.7rem 1.45rem;
      }
    }
  </style>
</head>
<body>
  <div id="canvas-container"></div>

  <div id="hud" class="panel">
    <h1>Omni droid&nbsp;V8</h1>
    <p>Left joystick: move • Right joystick: look around • Works with touch or WASD&nbsp;+&nbsp;mouse.</p>
  </div>

  <button id="recenter" class="panel" type="button">Recenter Camera</button>

  <div id="leftJoystick" class="joystick">
    <div class="stick"></div>
  </div>

  <div id="rightJoystick" class="joystick">
    <div class="stick"></div>
  </div>

  <script type="module">
    import * as THREE from "https://cdn.jsdelivr.net/npm/three@0.161.0/build/three.module.js";

    const container = document.getElementById("canvas-container");
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.08;
    renderer.domElement.id = "omniCanvas";
    container.appendChild(renderer.domElement);

    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x04070f, 0.045);

    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 120);
    camera.position.set(0, 3.6, 8.5);

    const hemiLight = new THREE.HemisphereLight(0x3c4da8, 0x05060a, 0.85);
    scene.add(hemiLight);

    const keyLight = new THREE.DirectionalLight(0xffffff, 0.55);
    keyLight.position.set(7, 12, 8);
    keyLight.castShadow = true;
    keyLight.shadow.bias = -0.0008;
    keyLight.shadow.mapSize.set(1024, 1024);
    keyLight.shadow.camera.top = 18;
    keyLight.shadow.camera.bottom = -12;
    keyLight.shadow.camera.left = -12;
    keyLight.shadow.camera.right = 12;
    keyLight.shadow.camera.far = 60;
    scene.add(keyLight);

    const rimLight = new THREE.PointLight(0x2d88ff, 1.25, 40, 2);
    rimLight.position.set(-6, 6, -8);
    scene.add(rimLight);

    const spotLight = new THREE.SpotLight(0xff7a36, 1.1, 45, Math.PI / 6, 0.35, 1.5);
    spotLight.position.set(0, 11, 2);
    spotLight.castShadow = true;
    spotLight.shadow.mapSize.set(1024, 1024);
    spotLight.target.position.set(0, 0, 0);
    scene.add(spotLight);
    scene.add(spotLight.target);

    const omniGroup = new THREE.Group();
    omniGroup.position.y = 1.2;
    scene.add(omniGroup);

    const bodyMaterial = new THREE.MeshStandardMaterial({
      color: 0x151b24,
      metalness: 0.72,
      roughness: 0.28
    });
    const body = new THREE.Mesh(new THREE.SphereGeometry(1.45, 48, 48), bodyMaterial);
    body.castShadow = true;
    body.receiveShadow = true;
    omniGroup.add(body);

    const platingMaterial = new THREE.MeshStandardMaterial({
      color: 0x0f141d,
      metalness: 0.65,
      roughness: 0.35
    });
    const plating = new THREE.Mesh(new THREE.TorusGeometry(1.45, 0.18, 32, 120), platingMaterial);
    plating.rotation.x = Math.PI / 2;
    plating.castShadow = true;
    omniGroup.add(plating);

    const accentMaterial = new THREE.MeshStandardMaterial({
      color: 0xff5f2e,
      emissive: 0xff4411,
      emissiveIntensity: 0.6,
      roughness: 0.32,
      metalness: 0.7
    });
    const core = new THREE.Mesh(new THREE.SphereGeometry(0.55, 40, 40), accentMaterial);
    core.position.z = 0.86;
    core.castShadow = true;
    omniGroup.add(core);

    const iris = new THREE.Mesh(
      new THREE.CylinderGeometry(0.22, 0.12, 0.5, 32),
      new THREE.MeshStandardMaterial({
        color: 0x0a1017,
        emissive: 0x3aa1ff,
        emissiveIntensity: 0.9,
        metalness: 0.4,
        roughness: 0.18
      })
    );
    iris.rotation.x = Math.PI / 2;
    iris.position.z = 1.18;
    iris.castShadow = true;
    omniGroup.add(iris);

    const antenna = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.05, 1.2, 24), bodyMaterial);
    antenna.position.y = 1.7;
    antenna.castShadow = true;
    omniGroup.add(antenna);

    const antennaTip = new THREE.Mesh(new THREE.SphereGeometry(0.15, 24, 24), accentMaterial);
    antennaTip.position.y = 2.3;
    antennaTip.castShadow = true;
    omniGroup.add(antennaTip);

    const limbMaterial = new THREE.MeshStandardMaterial({
      color: 0x1c2432,
      metalness: 0.82,
      roughness: 0.25
    });
    const clawMaterial = new THREE.MeshStandardMaterial({
      color: 0x080b11,
      metalness: 0.6,
      roughness: 0.32
    });

    for (let i = 0; i < 4; i++) {
      const limbGroup = new THREE.Group();
      limbGroup.rotation.y = i * Math.PI * 0.5;

      const joint = new THREE.Mesh(new THREE.SphereGeometry(0.32, 32, 32), accentMaterial);
      joint.position.x = 0.6;
      joint.castShadow = true;
      limbGroup.add(joint);

      const limb = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.28, 3.2, 32), limbMaterial);
      limb.rotation.z = Math.PI / 2;
      limb.position.x = 1.9;
      limb.castShadow = true;
      limbGroup.add(limb);

      const claw = new THREE.Mesh(new THREE.TorusGeometry(0.38, 0.1, 22, 40), clawMaterial);
      claw.rotation.y = Math.PI / 2;
      claw.position.x = 3.2;
      claw.castShadow = true;
      limbGroup.add(claw);

      omniGroup.add(limbGroup);
    }

    const lowerRing = new THREE.Mesh(new THREE.TorusGeometry(1.05, 0.1, 24, 80), accentMaterial);
    lowerRing.rotation.x = Math.PI / 2;
    lowerRing.position.y = -0.65;
    omniGroup.add(lowerRing);

    const thruster = new THREE.Mesh(
      new THREE.ConeGeometry(0.26, 0.9, 32, 1, true),
      new THREE.MeshStandardMaterial({
        color: 0xff7a38,
        emissive: 0xff4a18,
        emissiveIntensity: 0.7,
        metalness: 0.3,
        roughness: 0.25,
        transparent: true,
        opacity: 0.68,
        side: THREE.DoubleSide
      })
    );
    thruster.rotation.x = Math.PI;
    thruster.position.y = -1.2;
    omniGroup.add(thruster);

    const thrusterGlow = new THREE.Mesh(
      new THREE.CylinderGeometry(0.22, 0.02, 0.5, 32, 1, true),
      new THREE.MeshBasicMaterial({
        color: 0xff6b2f,
        transparent: true,
        opacity: 0.4,
        blending: THREE.AdditiveBlending,
        side: THREE.DoubleSide
      })
    );
    thrusterGlow.rotation.x = Math.PI / 2;
    thrusterGlow.position.y = -1.2;
    omniGroup.add(thrusterGlow);

    const arena = new THREE.Mesh(
      new THREE.CircleGeometry(60, 64),
      new THREE.MeshStandardMaterial({ color: 0x07090f, metalness: 0.08, roughness: 0.92 })
    );
    arena.rotation.x = -Math.PI / 2;
    arena.receiveShadow = true;
    scene.add(arena);

    const arenaRingOuter = new THREE.Mesh(
      new THREE.RingGeometry(8, 8.4, 80),
      new THREE.MeshBasicMaterial({
        color: 0x3a82ff,
        transparent: true,
        opacity: 0.3,
        side: THREE.DoubleSide
      })
    );
    arenaRingOuter.rotation.x = -Math.PI / 2;
    arenaRingOuter.position.y = 0.02;
    scene.add(arenaRingOuter);

    const arenaRingInner = new THREE.Mesh(
      new THREE.RingGeometry(3.6, 3.9, 64),
      new THREE.MeshBasicMaterial({
        color: 0xff6a32,
        transparent: true,
        opacity: 0.42,
        side: THREE.DoubleSide
      })
    );
    arenaRingInner.rotation.x = -Math.PI / 2;
    arenaRingInner.position.y = 0.02;
    scene.add(arenaRingInner);

    const starsGeometry = new THREE.BufferGeometry();
    const starCount = 480;
    const starPositions = new Float32Array(starCount * 3);
    for (let i = 0; i < starCount; i++) {
      const i3 = i * 3;
      starPositions[i3] = (Math.random() - 0.5) * 160;
      starPositions[i3 + 1] = Math.random() * 60 + 10;
      starPositions[i3 + 2] = (Math.random() - 0.5) * 160;
    }
    starsGeometry.setAttribute("position", new THREE.BufferAttribute(starPositions, 3));
    const starsMaterial = new THREE.PointsMaterial({
      color: 0x7aa8ff,
      size: 0.45,
      sizeAttenuation: true,
      transparent: true,
      opacity: 0.8
    });
    const stars = new THREE.Points(starsGeometry, starsMaterial);
    scene.add(stars);

    const hoverGlow = new THREE.Mesh(
      new THREE.RingGeometry(0.8, 1.8, 64),
      new THREE.MeshBasicMaterial({
        color: 0xff6b2e,
        transparent: true,
        opacity: 0.35,
        blending: THREE.AdditiveBlending,
        side: THREE.DoubleSide
      })
    );
    hoverGlow.rotation.x = -Math.PI / 2;
    hoverGlow.position.y = 0.04;
    scene.add(hoverGlow);

    const leftStick = createJoystick("leftJoystick");
    const rightStick = createJoystick("rightJoystick");

    const keys = {};
    const listenedKeys = new Set([
      "KeyW",
      "KeyA",
      "KeyS",
      "KeyD",
      "ArrowUp",
      "ArrowDown",
      "ArrowLeft",
      "ArrowRight",
      "Space"
    ]);

    window.addEventListener("keydown", (event) => {
      if (listenedKeys.has(event.code)) {
        event.preventDefault();
      }
      keys[event.code] = true;
    });

    window.addEventListener("keyup", (event) => {
      keys[event.code] = false;
    });

    const pointerState = { active: false, id: null, x: 0, y: 0 };
    renderer.domElement.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse" && event.pointerType !== "pen") return;
      pointerState.active = true;
      pointerState.id = event.pointerId;
      pointerState.x = event.clientX;
      pointerState.y = event.clientY;
      renderer.domElement.setPointerCapture(event.pointerId);
    });

    renderer.domElement.addEventListener("pointermove", (event) => {
      if (!pointerState.active || event.pointerId !== pointerState.id) return;
      const dx = event.clientX - pointerState.x;
      const dy = event.clientY - pointerState.y;
      pointerState.x = event.clientX;
      pointerState.y = event.clientY;
      cameraYaw -= dx * 0.0032;
      cameraPitch -= dy * 0.0022;
      clampPitch();
    });

    const releasePointer = (event) => {
      if (pointerState.active && event.pointerId === pointerState.id) {
        pointerState.active = false;
        renderer.domElement.releasePointerCapture(event.pointerId);
      }
    };

    renderer.domElement.addEventListener("pointerup", releasePointer);
    renderer.domElement.addEventListener("pointercancel", releasePointer);
    renderer.domElement.addEventListener("contextmenu", (event) => event.preventDefault());

    function createJoystick(id) {
      const container = document.getElementById(id);
      const stick = container.querySelector(".stick");
      const state = { x: 0, y: 0 };
      let pointerId = null;
      let active = false;
      let maxDistance = container.clientWidth / 2;

      const setStick = (dx, dy) => {
        const distance = Math.min(Math.hypot(dx, dy), maxDistance);
        const angle = Math.atan2(dy, dx);
        const x = Math.cos(angle) * distance;
        const y = Math.sin(angle) * distance;
        state.x = (maxDistance === 0 ? 0 : x / maxDistance);
        state.y = (maxDistance === 0 ? 0 : -y / maxDistance);
        stick.style.setProperty("--x", `${x}px`);
        stick.style.setProperty("--y", `${y}px`);
      };

      const resetStick = () => {
        state.x = 0;
        state.y = 0;
        stick.style.setProperty("--x", "0px");
        stick.style.setProperty("--y", "0px");
      };

      const updateFromEvent = (event) => {
        const rect = container.getBoundingClientRect();
        const dx = event.clientX - (rect.left + rect.width / 2);
        const dy = event.clientY - (rect.top + rect.height / 2);
        setStick(dx, dy);
      };

      container.addEventListener("pointerdown", (event) => {
        pointerId = event.pointerId;
        active = true;
        container.classList.add("active");
        container.setPointerCapture(pointerId);
        updateFromEvent(event);
        event.preventDefault();
      }, { passive: false });

      container.addEventListener("pointermove", (event) => {
        if (!active || event.pointerId !== pointerId) return;
        updateFromEvent(event);
        event.preventDefault();
      }, { passive: false });

      const release = (event) => {
        if (!active || event.pointerId !== pointerId) return;
        active = false;
        pointerId = null;
        container.classList.remove("active");
        resetStick();
        try {
          container.releasePointerCapture(event.pointerId);
        } catch (_) {
          /* ignore */
        }
      };

      container.addEventListener("pointerup", release);
      container.addEventListener("pointercancel", release);

      const updateBounds = () => {
        maxDistance = container.clientWidth / 2;
        resetStick();
      };

      window.addEventListener("resize", updateBounds);
      window.addEventListener("orientationchange", () => setTimeout(updateBounds, 250));

      return {
        state,
        reset: resetStick,
        updateBounds
      };
    }

    const recenterBtn = document.getElementById("recenter");
    recenterBtn.addEventListener("click", () => {
      cameraYaw = omniHeading;
      cameraPitch = 0.3;
      clampPitch();
      leftStick.reset();
      rightStick.reset();
    });

    let cameraYaw = Math.PI / 4;
    let cameraPitch = 0.32;
    const cameraRadius = 9;
    const lookOffset = new THREE.Vector3(0, 1.3, 0);
    const desiredCamera = new THREE.Vector3();
    const cameraLook = omniGroup.position.clone().add(lookOffset);
    const velocity = new THREE.Vector3(0, 0, 0);
    let omniHeading = 0;
    let omniHeadingTarget = 0;

    function clampPitch() {
      cameraPitch = THREE.MathUtils.clamp(cameraPitch, -0.12, 1.18);
    }

    function dampAngle(current, target, lambda, delta) {
      const diff = THREE.MathUtils.euclideanModulo(target - current + Math.PI, Math.PI * 2) - Math.PI;
      return current + diff * (1 - Math.exp(-lambda * delta));
    }

    function updateCamera(delta) {
      const cosPitch = Math.cos(cameraPitch);
      const sinPitch = Math.sin(cameraPitch);
      desiredCamera.copy(omniGroup.position);
      desiredCamera.x += Math.sin(cameraYaw) * cosPitch * cameraRadius;
      desiredCamera.y += sinPitch * cameraRadius + 2.3;
      desiredCamera.z += Math.cos(cameraYaw) * cosPitch * cameraRadius;

      camera.position.x = THREE.MathUtils.damp(camera.position.x, desiredCamera.x, 3.5, delta);
      camera.position.y = THREE.MathUtils.damp(camera.position.y, desiredCamera.y, 3.5, delta);
      camera.position.z = THREE.MathUtils.damp(camera.position.z, desiredCamera.z, 3.5, delta);

      cameraLook.x = THREE.MathUtils.damp(cameraLook.x, omniGroup.position.x + lookOffset.x, 6, delta);
      cameraLook.y = THREE.MathUtils.damp(cameraLook.y, omniGroup.position.y + lookOffset.y, 6, delta);
      cameraLook.z = THREE.MathUtils.damp(cameraLook.z, omniGroup.position.z + lookOffset.z, 6, delta);

      camera.lookAt(cameraLook);
    }

    const clock = new THREE.Clock();

    function animate() {
      const delta = Math.min(clock.getDelta(), 0.05);
      const elapsed = clock.elapsedTime;

      cameraYaw -= rightStick.state.x * 2.4 * delta;
      cameraPitch += rightStick.state.y * 1.6 * delta;
      clampPitch();

      let moveX = leftStick.state.x;
      let moveY = leftStick.state.y;

      if (keys.KeyW || keys.ArrowUp) moveY += 1;
      if (keys.KeyS || keys.ArrowDown) moveY -= 1;
      if (keys.KeyA || keys.ArrowLeft) moveX -= 1;
      if (keys.KeyD || keys.ArrowRight) moveX += 1;

      let magnitude = Math.hypot(moveX, moveY);
      if (magnitude > 0) {
        const maxMag = Math.max(1, magnitude);
        moveX /= maxMag;
        moveY /= maxMag;
        magnitude = Math.min(1, magnitude);

        const angle = Math.atan2(moveX, moveY);
        const worldAngle = angle + cameraYaw;
        const targetSpeed = magnitude * 6.8;
        const desiredVelX = Math.sin(worldAngle) * targetSpeed;
        const desiredVelZ = Math.cos(worldAngle) * targetSpeed;

        velocity.x = THREE.MathUtils.damp(velocity.x, desiredVelX, 8, delta);
        velocity.z = THREE.MathUtils.damp(velocity.z, desiredVelZ, 8, delta);

        omniHeadingTarget = worldAngle;
      } else {
        velocity.x = THREE.MathUtils.damp(velocity.x, 0, 6, delta);
        velocity.z = THREE.MathUtils.damp(velocity.z, 0, 6, delta);
      }

      omniGroup.position.x += velocity.x * delta;
      omniGroup.position.z += velocity.z * delta;

      omniHeading = dampAngle(omniHeading, omniHeadingTarget, 6, delta);
      omniGroup.rotation.y = omniHeading;

      const bob = Math.sin(elapsed * 2.4) * 0.12;
      omniGroup.position.y = 1.22 + bob;
      hoverGlow.scale.setScalar(1 + Math.sin(elapsed * 2.2) * 0.08 + Math.hypot(velocity.x, velocity.z) * 0.05);
      hoverGlow.material.opacity = 0.24 + Math.min(0.25, Math.hypot(velocity.x, velocity.z) * 0.05);

      body.rotation.x = THREE.MathUtils.damp(body.rotation.x, velocity.z * 0.065, 5, delta);
      body.rotation.z = THREE.MathUtils.damp(body.rotation.z, -velocity.x * 0.085, 5, delta);
      plating.rotation.z += delta * 0.4;
      core.material.emissiveIntensity = 0.55 + Math.sin(elapsed * 5.2) * 0.25;
      thruster.material.opacity = 0.55 + Math.min(0.35, Math.hypot(velocity.x, velocity.z) * 0.1);

      stars.rotation.y += 0.02 * delta;

      updateCamera(delta);
      renderer.render(scene, camera);
    }

    renderer.setAnimationLoop(animate);

    function handleResize() {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      leftStick.updateBounds();
      rightStick.updateBounds();
    }

    window.addEventListener("resize", handleResize);
    window.addEventListener("orientationchange", () => setTimeout(handleResize, 300));

    handleResize();
  </script>
</body>
</html>
